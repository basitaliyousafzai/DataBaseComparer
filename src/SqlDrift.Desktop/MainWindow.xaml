<Window x:Class="SqlDrift.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLDrift — Backup Compare" Height="800" Width="1220"
        Background="#F1F5F9" Foreground="#0F172A" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgInput" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#475569"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="Success" Color="#059669"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="RowBackground" Value="{StaticResource BgCard}"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="12" Padding="18" Margin="0,0,0,12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="SQLDrift Backup Compare" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Attach .bak backups of the same database, compare schema + data + views + stored procedures, and generate safe migration scripts." Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Connection + attach -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="SQL Server instance connection string" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="ServerTextBox" Text="Server=localhost;Integrated Security=true;TrustServerCertificate=true;" Margin="0,0,8,0"/>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="AddBackupsButton" Content="Attach .bak files" Click="AddBackups_Click" Margin="0,0,8,0" Background="{StaticResource Accent}"/>
                    <Button x:Name="ClearBackupsButton" Content="Clear" Click="ClearBackups_Click" Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Attached backups:" Foreground="{StaticResource TextMuted}" Margin="0,8,0,4"/>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="12" Padding="12" Margin="0,0,12,0" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="BackupsListBox" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Source backup:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SourceCombo" Margin="0,0,0,10"/>
                        <TextBlock Text="Target backup:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TargetCombo" Margin="0,0,0,10"/>
                        <Button x:Name="CompareButton" Content="Compare Backups" Click="Compare_Click" Background="{StaticResource Accent}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="12" Padding="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SummaryText" Grid.Row="0" Text="No comparison yet." Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="5" IsIndeterminate="False" Visibility="Collapsed" Margin="0,0,0,8" Background="{StaticResource BgInput}" Foreground="{StaticResource Accent}"/>

                    <TabControl Grid.Row="2" Background="{StaticResource BgCard}" BorderThickness="0">
                        <TabItem Header="Drifts">
                            <DataGrid x:Name="DriftsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding ObjectType}" Width="110"/>
                                    <DataGridTextColumn Header="Object" Binding="{Binding FullName}" Width="200"/>
                                    <DataGridTextColumn Header="Drift" Binding="{Binding DriftType}" Width="90"/>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Script">
                            <TextBox x:Name="ScriptTextBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"/>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="GenerateScriptButton" Content="Generate Migration Script" Click="GenerateScript_Click" Background="{StaticResource Success}" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="8" Padding="10" Margin="0,12,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource TextMuted}"/>
        </Border>
    </Grid>
</Window>