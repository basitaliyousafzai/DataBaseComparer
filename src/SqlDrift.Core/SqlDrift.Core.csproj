<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SqlDrift.Core</RootNamespace>
    <AssemblyName>SqlDrift.Core</AssemblyName>
    <PackageId>SqlDrift.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>SqlDrift Contributors</Authors>
    <Description>Core schema extraction, semantic diff engine, DAG planner, and safe idempotent script generator for SQL Server.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.3.0" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
  </ItemGroup>

</Project>
